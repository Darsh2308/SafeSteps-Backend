# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

PROJECT_NAME="Safe Steps AI Backend"
SECRET_KEY="generate-with: python3 -c 'import secrets; print(secrets.token_hex(32))'"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# MongoDB Atlas
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="safesteps"

# AI Service Keys
# Groq:   https://console.groq.com/keys
# Sarvam: https://dashboard.sarvam.ai
# Gemini: https://aistudio.google.com/app/apikey
GROQ_API_KEY=""
SARVAM_API_KEY=""
GEMINI_API_KEY=""

# LangSmith Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="SafeSteps"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# Anthropic (reserved)
ANTHROPIC_API_KEY=""

# SMS is handled by the Android app via SmsManager — no gateway key needed
